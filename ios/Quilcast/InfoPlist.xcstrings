        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast verwendet das Mikrofon, wenn du in einem Space sprichst oder eine Mini-App, der du es erlaubt hast, darauf zugreifen möchte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
