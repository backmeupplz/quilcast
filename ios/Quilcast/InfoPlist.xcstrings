    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast saves images you choose to keep to your photo library."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Quilcast الصور التي تختار الاحتفاظ بها في مكتبة الصور لديك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast speichert Bilder, die du behalten möchtest, in deiner Fotomediathek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast guarda en tu fototeca las imágenes que decidas conservar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast enregistre dans votre photothèque les images que vous choisissez de conserver."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जिन इमेज को रखना चुनते हैं, Quilcast उन्हें आपकी फ़ोटो लाइब्रेरी में सेव करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast menyimpan gambar pilihan Anda ke perpustakaan foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast salva nella tua libreria foto le immagini che scegli di conservare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残しておきたい画像を、Quilcastが写真ライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관하기로 선택한 이미지를 Quilcast가 사진 보관함에 저장해요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast bewaart afbeeldingen die je wilt houden in je fotobibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast zapisuje w Twojej bibliotece zdjęć obrazy, które chcesz zachować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Quilcast salva na sua fototeca as imagens que você escolher guardar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Quilcast guarda na tua fototeca as imagens que escolheres manter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast сохраняет в вашу медиатеку изображения, которые вы решили оставить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast sparar bilder som du väljer att behålla i ditt bildbibliotek."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast บันทึกภาพที่คุณเลือกเก็บไว้ลงในคลังรูปภาพของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast, saklamayı seçtiğiniz görselleri fotoğraf arşivinize kaydeder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast зберігає у вашу медіатеку зображення, які ви вирішили залишити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quilcast lưu những hình ảnh bạn chọn giữ lại vào thư viện ảnh của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
