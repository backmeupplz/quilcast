<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- no title bar; the window shows the page's own paper color (index.html theme-color) until it draws -->
    <style name="Theme.Quilcast" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="paper">#FAF9F6</color>
    <color name="brand">#5B3DF5</color>
</resources>
